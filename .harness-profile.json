{
  "version": "1.5.0",
  "preset": "custom",
  "projectName": "haja-web-fe",
  "description": "이벤트 히스토리 모델과 불렛저널 시스템을 결합한 하루 단위 태스크 관리 웹 앱",
  "stack": {
    "framework": "React 19",
    "language": "TypeScript 5.7",
    "libraries": [
      "React Router v7",
      "Zustand 5",
      "Supabase",
      "Tailwind CSS v4",
      "shadcn/ui",
      "Tanstack React Query",
      "Zod",
      "react-hook-form",
      "immer",
      "lodash-es",
      "react-day-picker",
      "lucide-react"
    ]
  },
  "architectureType": "layer-based",
  "srcRoot": "src/",
  "pathAlias": "@/",
  "layers": {
    "order": [
      "types",
      "utils",
      "lib",
      "shared",
      "hooks",
      "contexts",
      "components",
      "pages",
      "app"
    ],
    "rules": {
      "types": {
        "allowedImports": []
      },
      "utils": {
        "allowedImports": [
          "types"
        ]
      },
      "lib": {
        "allowedImports": [
          "types"
        ]
      },
      "shared": {
        "allowedImports": [
          "types",
          "utils",
          "lib"
        ]
      },
      "hooks": {
        "allowedImports": [
          "types",
          "utils",
          "lib",
          "shared"
        ]
      },
      "contexts": {
        "allowedImports": [
          "types",
          "lib",
          "shared",
          "hooks"
        ]
      },
      "components": {
        "allowedImports": [
          "types",
          "utils",
          "lib",
          "shared",
          "hooks"
        ]
      },
      "pages": {
        "allowedImports": [
          "types",
          "utils",
          "lib",
          "shared",
          "hooks",
          "contexts",
          "components"
        ]
      },
      "app": {
        "allowedImports": [
          "types",
          "utils",
          "lib",
          "shared",
          "hooks",
          "contexts",
          "components",
          "pages"
        ]
      }
    },
    "descriptions": {
      "types": "공유 타입, enum, interface (shared/types/)",
      "utils": "순수 유틸리티 함수 (dateUtils 등)",
      "lib": "외부 서비스 초기화 (Supabase, cn 유틸)",
      "shared": "도메인 모델(TaskCore) + Zustand 스토어",
      "hooks": "React 커스텀 훅 (useAuth, useBulletSection 등)",
      "contexts": "React Context (AuthContext)",
      "components": "UI 컴포넌트 (bulletList/, modal/, ui/)",
      "pages": "라우트 페이지 컴포넌트",
      "app": "앱 진입점·라우팅 — 전용 폴더 없음, src 루트의 진입점 파일(root.tsx, App.tsx, routes.ts, entry.client.tsx, catchall.tsx)이 담당"
    }
  },
  "folderRoles": {
    "src/shared/types": "공유 타입, enum, interface",
    "src/utils": "순수 유틸리티 함수",
    "src/lib": "외부 서비스 초기화 (Supabase 클라이언트, cn 유틸)",
    "src/shared": "도메인 모델(TaskCore) + Zustand 스토어",
    "src/hooks": "React 커스텀 훅",
    "src/contexts": "React Context (AuthContext)",
    "src/components": "UI 컴포넌트",
    "src/components/ui": "shadcn/ui 기반 공통 컴포넌트",
    "src/components/bulletList": "불렛 리스트 관련 컴포넌트",
    "src/components/modal": "모달 컴포넌트",
    "src/pages": "라우트별 페이지",
    "src/test": "테스트 파일",
    "src/assets": "정적 자산"
  },
  "extraArchitectureRules": [
    "components/ui/는 shared 스토어를 직접 import하지 않음 (훅을 통해서만)",
    "pages/는 비즈니스 로직을 직접 포함하지 않음",
    "MVP 완료 후 FSD(Feature-Sliced Design) 아키텍처로 리팩토링 검토 예정"
  ],
  "conservativeRules": {
    "approach": "프론트엔드 보안 민감 작업 시: 작업 이유 + 변경 시 이득 설명 → 사용자 승인 후 진행",
    "serverInfra": [
      "Supabase 테이블 스키마 변경 — 보수적 접근",
      "Supabase RLS 정책 수정 — 보수적 접근",
      "환경 변수(.env) 수정/생성 — 사전 확인 필요",
      "인증 플로우(OAuth) 핵심 로직 변경 — 보수적 접근",
      "src/lib/supabase.ts 클라이언트 초기화 코드 변경 — 보수적 접근"
    ],
    "code": [
      "TaskCore 클래스의 불변성 패턴 변경 — 이유 설명 + 대안 문서화 후 승인",
      "Zustand 미들웨어 스택 순서 변경 — 이유 설명 + 대안 문서화 후 승인",
      "localStorage 키(localBullets) 변경 — 데이터 유실 위험, 마이그레이션 계획 필수"
    ],
    "dependencies": [
      "새 패키지 추가 시 사용자 확인 후 진행",
      "기존 패키지 메이저 버전 업그레이드 시 사용자 확인 필요"
    ],
    "documentation": "변경 사항과 방향성을 docs/TECH_DEBT.md에 기록"
  },
  "naming": {
    "components": "PascalCase (예: TaskItem.tsx)",
    "hooks": "camelCase + use 접두사 (예: useAuth.ts)",
    "stores": "camelCase + Store 접미사 (예: bulletStore.ts)",
    "types": "PascalCase + Type/Props 접미사",
    "tests": "원본명.test.ts(x)"
  },
  "devServer": {
    "command": "yarn dev",
    "port": 5173,
    "readyCheck": "curl -s -o /dev/null -w '%{http_code}' http://localhost:5173"
  },
  "scripts": {
    "validate": "yarn build && yarn test:run && yarn lint",
    "test": "yarn test:run",
    "build": "yarn build",
    "lint": "yarn lint"
  },
  "tdd": {
    "securityCategories": "auth, security, api",
    "maxImplementerAttempts": 3,
    "maxDebuggerAttempts": 2
  },
  "git": {
    "commitScopes": null,
    "commitLang": "ko",
    "branchPrefixes": [
      "feature/",
      "fix/",
      "docs/",
      "refactor/",
      "chore/"
    ],
    "mainBranch": "main"
  },
  "docFreshnessDays": 14,
  "integrations": {
    "superpowers": {
      "enabled": true,
      "source": "plugin",
      "detectedVersion": "5.1.0",
      "installPath": "/Users/daehyun/.claude/plugins/cache/claude-plugins-official/superpowers/5.1.0",
      "linkedSkills": [
        "brainstorming",
        "systematic-debugging",
        "writing-plans"
      ]
    }
  },
  "extras": {
    "stateManagement": {
      "tool": "Zustand 5",
      "storeLocation": "src/shared/",
      "middlewareStack": "devtools → subscribeWithSelector → persist → immer",
      "persistKey": "localBullets",
      "accessRules": "selector 함수 사용 권장"
    },
    "backendIntegration": {
      "provider": "Supabase",
      "clientLocation": "src/lib/supabase.ts",
      "auth": "Google OAuth",
      "authLocation": "src/contexts/AuthContext.tsx + src/hooks/useAuth.ts",
      "status": "현재 localStorage 중심, 백엔드 연동 준비 중"
    },
    "domainModel": {
      "type": "class-based",
      "pattern": "immutable-copy",
      "model": "TaskCore",
      "location": "src/shared/TaskCore.ts",
      "stateTransitions": "활성 상태(TODO·ONGOING·DELAY) 간 자유 전이, 활성 → DONE/CANCEL 종결, DONE → TODO·CANCEL → TODO만 복귀 허용",
      "eventSourcing": true,
      "methods": "with() 메서드로 새 인스턴스 반환, toJSON()/TaskCore.from(dto) 직렬화"
    },
    "routing": {
      "framework": "React Router v7",
      "mode": "framework (ssr: false — SPA 모드, appDirectory: src)",
      "routeDefinition": "src/routes.ts",
      "entryPoint": "src/entry.client.tsx"
    }
  },
